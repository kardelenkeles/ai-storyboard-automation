{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "types": ["node"],
    "outDir": "dist/main",
    "rootDir": "src",
    "sourceMap": true
  },
  "include": [
    "src/main/**/*.ts",
    "src/core/**/*.ts",
    "src/shared/**/*.ts",
    "src/common/**/*.ts",
    "src/infrastructure/**/*.ts",
    "src/types/**/*.d.ts"
  ],
  "exclude": ["src/renderer/**/*", "dist", "release", "node_modules"]
}