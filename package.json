{
  "name": "Video Automation Studio",
  "version": "1.0.0",
  "description": "A production-ready desktop application for automating AI video creation workflows",
  "main": "src/main/main.js",
  "module": "src/main/main.mjs",
  "types": "src/common/types.ts",
  "scripts": {
    "dev": "wait-on http://localhost:4444 && electron:serve",
    "build": "electron:build",
    "start": "wait-on http://localhost:4444 && electron:serve",
    "pack": "electron:build --dir",
    "dist": "electron:build --file"
  },
  "dependencies": {
    "electron": "^30.0.0",
    "playwright": "^1.44.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@electron/remote": "^2.1.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.17",
    "concurrently": "^8.2.2",
    "electron-builder": "^24.13.3",
    "electron-reload": "^2.0.0-alpha.1",
    "typescript": "^5.4.5",
    "vite": "^5.2.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.kardelenkeles.VideoAutomationStudio",
    "productName": "Video Automation Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "win": {
      "target": "NSIS"
    },
    "mac": {
      "target": "dmg"
    }
  }
}