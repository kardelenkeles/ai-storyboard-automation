{
  "name": "video-automation-studio",
  "version": "1.0.0",
  "private": true,
  "description": "A production-ready desktop application for automating AI video creation workflows",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:preload\" \"npm:dev:electron\"",
    "dev:renderer": "vite --config src/renderer/vite.config.ts",
    "dev:main": "tsc -p tsconfig.main.json --watch --preserveWatchOutput",
    "dev:preload": "tsc -p tsconfig.preload.json --watch --preserveWatchOutput",
    "dev:electron": "wait-on dist/main/main.js dist/preload/index.js http://localhost:4444 && electron .",
    "build": "npm run build:renderer && npm run build:main && npm run build:preload && electron-builder",
    "build:renderer": "vite build --config src/renderer/vite.config.ts",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "typecheck": "tsc -b tsconfig.main.json tsconfig.preload.json tsconfig.renderer.json --pretty false",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "start": "electron ."
  },
  "dependencies": {
    "electron": "^30.0.0",
    "playwright": "^1.44.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^8.2.2",
    "electron-builder": "^24.13.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.kardelenkeles.VideoAutomationStudio",
    "productName": "Video Automation Studio",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "README.md"
    ],
    "extraMetadata": {
      "main": "dist/main/main.js"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "win": {
      "target": "NSIS"
    },
    "mac": {
      "target": "dmg"
    }
  }
}
